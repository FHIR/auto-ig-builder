#!/bin/bash

set -e

DEPLOY_TO_BRANCH=$1

# Names a directory under the web root; refuse anything else (empty means the
# main build). Same rule as publish-ig.
SAFE_NAME="^[A-Za-z0-9._+,"$'\x80'"-"$'\xff'"-]+\$"
if [ -n "$DEPLOY_TO_BRANCH" ]; then
    if ! LC_ALL=C bash -c '[[ "$1" =~ $2 ]]' _ "$DEPLOY_TO_BRANCH" "$SAFE_NAME" || [ "$DEPLOY_TO_BRANCH" == "." ] || [ "$DEPLOY_TO_BRANCH" == ".." ]; then
        echo "Refusing unsafe name: $DEPLOY_TO_BRANCH" >&2
        exit 2
    fi
fi

function finish {
  kill $KEEPALIVE_PID
  # A failed or cut-off upload leaves its staging directory behind; after a
  # successful publish it has already been moved into place.
  if [ -n "${TARGET:-}" ] && [ -d ~/uploading/"$TARGET" ]; then rm -rf ~/uploading/"$TARGET"; fi
}
trap finish EXIT

TARGET=$RANDOM

mkdir -p ~/uploading/$TARGET
cd ~/uploading/$TARGET

while true; do sleep 10; du -hs .; done &
KEEPALIVE_PID=$!
tar xzf - && date --iso-8601 > ~/uploading/$TARGET/done.txt || false

if [ ! -z "$DEPLOY_TO_BRANCH" ]
then
    mv ~/uploading/www/branches/$DEPLOY_TO_BRANCH ~/uploading/branch.$TARGET.old  || true
    mkdir -p ~/uploading/www/branches
    mv ~/uploading/$TARGET/ ~/uploading/www/branches/$DEPLOY_TO_BRANCH
    rm -rf ~/uploading/branch.$TARGET.old || true
else
    mv ~/uploading/www/fhir ~/uploading/fhir.$TARGET.old  || true
    mkdir -p ~/uploading/www
    mv ~/uploading/$TARGET/ ~/uploading/www/fhir
    rm -rf ~/uploading/fhir.$TARGET.old || true
fi

# Delete old branches
cd ~/uploading/www/branches
find . -maxdepth 1 -path ./master -prune -o -type d -ctime +21  -path './*'  -exec rm -rf {} \;

